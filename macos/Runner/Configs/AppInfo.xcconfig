// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Anoya

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = org.annoya.test

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 org.anoya. All rights reserved.

// App Store category. Mandatory for the Mac App Store — an archive without
// LSApplicationCategoryType is rejected on upload with error 90242. Must stay a
// UTI from Apple's published list; it also has to agree with the primary
// category chosen in App Store Connect.
PRODUCT_APP_CATEGORY = public.app-category.utilities
