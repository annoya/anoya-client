<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed (Flutter default). Required so the host co-owns the App
	     Group container with the extension and can read logs/stats without the
	     macOS "access data from other apps" TCC prompt. The macOS tunnel uses
	     the Network Extension, so the host no longer needs to spawn processes. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Open a config file, and save the log archive where the user picks. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Network Extension: the host app manages the packet-tunnel. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- Shared container with the extension (logs + stats). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.annoya.test</string>
	</array>
	<!-- Data-protection keychain access group (required for flutter_secure_storage
	     under the sandbox). $(AppIdentifierPrefix) expands to the team ID. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)org.annoya.test</string>
	</array>
</dict>
</plist>
