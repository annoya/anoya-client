<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed. The macOS tunnel is the Network Extension, so the host needs
	     no process-spawning exceptions. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Open a config file, and save the log archive where the user picks. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Network Extension: the host app manages the packet-tunnel. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- App Group container shared with the extension: the engine's home (geo
	     databases, rule lists). Logs travel over provider IPC, not this. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.annoya.test</string>
	</array>
	<!-- Data-protection keychain access group (required for flutter_secure_storage
	     under the sandbox). $(AppIdentifierPrefix) expands to the team ID. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)org.annoya.test</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
