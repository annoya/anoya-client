# === OS / editor ===
.DS_Store
.idea/
.vscode/
*.swp

# === Go (management + worker + shared) ===
/bin/
*.test
*.out
coverage.txt
go.work.sum
# Compiled service binaries
/management/management
/worker/worker

# === Local runtime data / secrets (never commit) ===
*.db
*.db-wal
*.db-shm
/data/
**/data/
jwt.secret
certs/
*.pem
*.key

# === Embedded admin SPA build output ===
# The React app is built into dist/ by Vite / the Docker build. Keep the
# index.html placeholder so `//go:embed all:dist` compiles on a fresh checkout.
/management/internal/webui/dist/*
!/management/internal/webui/dist/index.html
# Frontend deps
/management/webui/node_modules/

# === Worker: bundled Xray binary (downloaded during Docker build) ===
/worker/internal/backend/xray-bin/

# === Flutter client ===
/client/.dart_tool/
/client/build/
/client/.flutter-plugins
/client/.flutter-plugins-dependencies
# CocoaPods / Flutter-generated (macOS/iOS)
**/Pods/
**/Flutter/ephemeral/
**/xcuserdata/

# === Native mihomo core (regenerated by build-xcframework.sh) ===
# 129 MB artifacts — exceed GitHub's 100 MB file limit, must never be committed.
/client/native/mihomocore/build/
*.xcframework
