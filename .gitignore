# === OS / editor ===
.DS_Store
.idea/
.vscode/
*.swp
*.log
*.pyc
.atom/
.history
.svn/
.swiftpm/

# === IntelliJ / Android Studio project files ===
*.iml
*.ipr
*.iws
*.class

# === Local secrets (never commit) ===
# Amnezia gateway credentials — someone else's key and endpoints, supplied at
# build time (see client-secrets.example.json). A build without them simply
# has no Amnezia support.
client-secrets.json
*.pem
*.key

# === Flutter / Dart ===
.dart_tool/
# Local-only dependency overrides; never someone else's business
pubspec_overrides.yaml
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
migrate_working_dir/
.build/
.buildlog/

# Symbolication and obfuscation output
app.*.symbols
app.*.map.json

# === CocoaPods / Xcode / Flutter-generated (macOS, iOS) ===
**/Pods/
**/Flutter/ephemeral/
**/xcuserdata/
**/DerivedData/
# Plugin symlinks pod install writes (ios/.gitignore has this; macOS needs it
# spelled out here)
**/.symlinks/

# === Android build artifacts ===
# Kotlin 2.x session directory, written by every Gradle build
/android/.kotlin/
/android/app/debug
/android/app/profile
/android/app/release

# === Native mihomo core (regenerated by build-xcframework.sh) ===
# 129 MB artifacts — exceed GitHub's 100 MB file limit, must never be committed.
/native/mihomocore/build/
*.xcframework
